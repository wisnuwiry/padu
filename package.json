{
  "name": "padu-workspace",
  "type": "module",
  "scripts": {
    "dev": "bun ./scripts/dev.ts",
    "release": "bun ./scripts/release.ts",
    "protocol:generate": "cargo run -p padu-protocol --bin export_types",
    "protocol:check": "cargo run -p padu-protocol --bin export_types -- --check",
    "provider:test": "cargo run -p padu-daemon --bin padu-provider-test --",
    "provider:list": "cargo run -p padu-daemon --bin padu-provider-test -- list",
    "theme:generate": "bun ./scripts/generate-themes.ts",
    "theme:check": "bun ./scripts/generate-themes.ts --check",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "rich-render:build": "bun ./scripts/build-rich-render.ts",
    "clean": "bun ./scripts/clean.ts",
    "clean:all": "bun ./scripts/clean.ts --all",
    "clean:cargo": "bun ./scripts/clean.ts --cargo",
    "desktop:dev": "bun ./scripts/dev.ts",
    "desktop:build": "cargo build --package padu --bin padu --bin padu_js_repl",
    "desktop:check": "cargo check --package padu",
    "desktop:test": "cargo test --package padu",
    "desktop:clean": "bun ./scripts/clean.ts --desktop",
    "web:dev": "bun run --filter @padu/web dev",
    "web:build": "bun run --filter @padu/web build",
    "web:preview": "bun run --filter @padu/web preview",
    "web:typecheck": "bun run --filter @padu/web typecheck",
    "web:test": "bun run --filter @padu/web test",
    "web:deploy": "bun run --filter @padu/web deploy",
    "web:clean": "bun ./scripts/clean.ts --web",
    "landing:dev": "bun run --filter @padu/landing dev",
    "landing:build": "bun run --filter @padu/landing build",
    "landing:preview": "bun run --filter @padu/landing preview",
    "landing:typecheck": "bun run --filter @padu/landing typecheck",
    "landing:test": "bun run --filter @padu/landing test",
    "landing:deploy": "bun run --filter @padu/landing deploy",
    "landing:clean": "bun ./scripts/clean.ts --landing",
    "mobile:start": "bun run --filter @padu/mobile start",
    "mobile:ios": "bun run --filter @padu/mobile ios",
    "mobile:android": "bun run --filter @padu/mobile android",
    "mobile:web": "bun run --filter @padu/mobile web",
    "mobile:typecheck": "bun run --filter @padu/mobile typecheck",
    "mobile:test": "bun run --filter @padu/mobile test",
    "mobile:clean": "bun ./scripts/clean.ts --mobile"
  },
  "private": true,
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "linkedom": "^0.18.13",
    "mathjax-full": "^3.2.2",
    "mermaid": "^12.0.0",
    "typescript": "^7.0.2"
  },
  "workspaces": ["apps/*", "packages/*"]
}
